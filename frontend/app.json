{
  "expo": {
    "name": "DevOS",
    "slug": "devos",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "devos",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.devos.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.devos.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0db5da9-2ead-4318-8add-2e8df8c5901a"
      }
    }
  }
}
