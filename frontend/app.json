{
  "expo": {
    "name": "DevOS",
    "slug": "devos",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "devos",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#07070E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.devos.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.devos.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0db5da9-2ead-4318-8add-2e8df8c5901a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c0db5da9-2ead-4318-8add-2e8df8c5901a"
    }
  }
}
